# ============================================================
# Hackathon 2026 - Configuração de Ambiente
#
# Todas as configurações específicas do ambiente devem ser
# realizadas neste arquivo, conforme a metodologia
# Twelve-Factor App:
# https://12factor.net/pt_br/config
# Saiba mais assistindo ao vídeo do Fábio Akita:
# https://youtu.be/gpJgtED36U4
# ============================================================

# ------------------------------------------------------------------
# Segurança
# ------------------------------------------------------------------

# A chave secreta do Django é utilizada internamente para assinar
# sessões, tokens e outras informações sensíveis da aplicação.
# Ela deve ser mantida em segredo e nunca compartilhada publicamente.
# Para gerar uma nova chave secreta você pode utilizar:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

SECRET_KEY=gere-uma-chave-local-segura

# Em produção use DEBUG=False.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------------------------------
# Banco de Dados
# ------------------------------------------------------------------

DATABASE_URL=sqlite:///db.sqlite3
# Exemplo produção:
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# ------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------

FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------
# Cloudinary (opcional)
# ------------------------------------------------------------------

CLOUDINARY_URL=

# ------------------------------------------------------------------
# Agente de IA (opcional)
# ------------------------------------------------------------------

# Mantenha a chave somente no backend/servidor. Nunca coloque no Vue/Vite.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
