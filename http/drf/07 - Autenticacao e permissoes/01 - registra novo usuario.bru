meta {
  name: 01 - registra novo usuario (201)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/registro/
  body: json
  auth: none
}

body:json {
  {
    "email": "aluno{{$guid}}@a.com",
    "name": "Aluno Teste",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("email_aluno", res.body.email);
  bru.setVar("id_aluno", res.body.id);
}

assert {
  res.status: eq 201
  res.body.email: isDefined
  res.body.id: isDefined
}

docs {
POST /api/registro/ — cadastro de usuário (seção 18.1).
Usa e-mail dinâmico {{$guid}} para não depender de seed nem do
comprador1@a.com do tutorial (que já existe no banco de referência).
Pré-condição: SimpleJWT ativo (seção 16–18).
}