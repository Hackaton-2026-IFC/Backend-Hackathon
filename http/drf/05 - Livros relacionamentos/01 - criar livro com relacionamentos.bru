meta {
  name: 01 - Criar livro com relacionamentos (401 em anônimo)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/livros/
  body: json
  auth: none
}

body:json {
  {
    "titulo": "Dominando o Django",
    "isbn": "978-85-001",
    "quantidade": 10,
    "preco": 59.9,
    "categoria": {{categoria_id}},
    "editora": {{editora_id}},
    "autores": [{{autor_id}}]
  }
}

assert {
  res.status: eq 401
}

docs {
POST /api/livros/ — payload das seções 9–10: FK categoria/editora e
M2M autores. O serializer de escrita (seção 11) é "achatado": envia ids.
Preencha categoria_id/editora_id/autor_id (Save-as-variable). Escrita
anônima é bloqueada (401) antes da seção 16; autenticado, retorna 201.
}