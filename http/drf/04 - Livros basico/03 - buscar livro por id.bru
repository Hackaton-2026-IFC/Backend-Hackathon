meta {
  name: 03 - Buscar livro por id (200)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/livros/{{livro_id}}/
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq {{livro_id}}
  res.body.titulo: isDefined
}

docs {
GET /api/livros/{id}/ — busca um livro por id (requer seção 8).
Defina a variável "livro_id" no ambiente Local com um id existente.
}