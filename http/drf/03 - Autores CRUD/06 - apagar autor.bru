meta {
  name: 06 - Apagar autor (401 em anônimo)
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/autores/{{autor_id}}/
  body: none
  auth: none
}

assert {
  res.status: eq 401
}

docs {
DELETE /api/autores/{id}/ — exclusão ensinada na seção 7.
Escrita anônima é bloqueada (401) antes da seção 16;
autenticado, a exclusão retorna 204.
}